<div class="lb" id="lb" role="dialog" aria-label="Photo viewer"><button class="x" aria-label="Close">&times;</button><button class="p" aria-label="Previous photo">&#8592;</button><img alt=""><button class="n" aria-label="Next photo">&#8594;</button><p class="cap"></p></div>
<script is:inline>
(function(){var g=[].slice.call(document.querySelectorAll('.l-gal .g')),lb=document.getElementById('lb'),im=lb.querySelector('img'),cap=lb.querySelector('.cap'),i=0;
function show(k){i=(k+g.length)%g.length;var s=g[i].querySelector('img');im.src=s.src;im.alt=s.alt;cap.textContent=s.alt+'  ·  '+(i+1)+' / '+g.length;lb.classList.add('on');}
g.forEach(function(b,k){b.addEventListener('click',function(){show(k)})});
lb.querySelector('.x').onclick=function(){lb.classList.remove('on')};
lb.querySelector('.p').onclick=function(){show(i-1)};lb.querySelector('.n').onclick=function(){show(i+1)};
lb.addEventListener('click',function(e){if(e.target===lb)lb.classList.remove('on')});
document.addEventListener('keydown',function(e){if(!lb.classList.contains('on'))return;if(e.key==='Escape')lb.classList.remove('on');if(e.key==='ArrowLeft')show(i-1);if(e.key==='ArrowRight')show(i+1)});
})();
</script>
<script is:inline>
(function(){var st=document.querySelector('.l-cover .stage');if(!st)return;var im=st.querySelector('#cv'),ct=st.querySelector('.count');
var g=[].slice.call(document.querySelectorAll('.l-gal .g img')),first={src:im.src,alt:im.alt},i=0;
function show(k){i=(k+g.length)%g.length;var x=i===0?first:g[i];im.src=x.src;im.alt=x.alt;ct.textContent=(i+1)+' / '+g.length;}
st.querySelector('.prev').onclick=function(){show(i-1)};st.querySelector('.next').onclick=function(){show(i+1)};
var x0=null;st.addEventListener('touchstart',function(e){x0=e.touches[0].clientX},{passive:true});
st.addEventListener('touchend',function(e){if(x0===null)return;var d=e.changedTouches[0].clientX-x0;if(Math.abs(d)>40)show(i+(d<0?1:-1));x0=null});
document.addEventListener('keydown',function(e){if(document.getElementById('lb').classList.contains('on'))return;if(e.key==='ArrowLeft')show(i-1);if(e.key==='ArrowRight')show(i+1)});
})();
</script>
