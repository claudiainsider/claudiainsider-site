---
// Perch on Swallowtail sold page: 331 Swallowtail Court, Brisbane (approved mockup v1, Nov 16, 2026).
// Photos live in public/listings/331-swallowtail-ct/. Shared styles: public/listings/listing.css.
import HubLayout from '../../layouts/HubLayout.astro';
const TITLE = 'Perch on Swallowtail | Sold: 331 Swallowtail Ct, Brisbane, CA 94005';
const DESC = 'Perch on Swallowtail: a 2 bed, 2 bath top-floor corner condo at 331 Swallowtail Court in Brisbane, CA, in the Altamar at the Ridge. Sold for $700,000 after 27 days on market.';
const URL = 'https://claudiainsider.com/listings/331-swallowtail-ct/';
const SHARE = 'https://claudiainsider.com/listings/331-swallowtail-ct/share.jpg';
const FAQ_LD = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What did 331 Swallowtail Court sell for?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "331 Swallowtail Court in Brisbane, CA sold for $700,000 in November 2026, after 27 days on market."
   }
  },
  {
   "@type": "Question",
   "name": "How big is the condo?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "It is a two-bedroom, two-bath top-floor corner condominium with 1,070 square feet per tax records."
   }
  },
  {
   "@type": "Question",
   "name": "What was updated before it sold?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The kitchen was the main focus, with all-new stainless steel appliances, countertops and backsplash."
   }
  },
  {
   "@type": "Question",
   "name": "Does it have parking and outdoor space?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes. There are two assigned parking spaces plus guest parking, and a private balcony reached from both the living room and the bedroom."
   }
  },
  {
   "@type": "Question",
   "name": "I'm thinking of selling in Brisbane. Can Claudia help?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes. Get in touch below and Claudia will map out what is worth doing before you list, and what is not."
   }
  }
 ]
};
---
<HubLayout title={TITLE} description={DESC} ogImage={SHARE} canonical={URL} current="listings">
<link slot="head" rel="stylesheet" href="/listings/listing.css">
<style slot="head" is:inline>
.l-cover .sold{position:absolute;left:var(--gut);top:22px;background:var(--linen);color:var(--espresso);font-size:11px;letter-spacing:.2em;text-transform:uppercase;padding:10px 16px}
.l-head .facts{list-style:none;margin:0 0 22px;padding:0}
.l-head .facts li{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--taupe);line-height:1.9}
.l-story .top p+p{margin-top:1.1em}
.l-story .top p{font-size:18px}
.l-sched .btn.lnk{display:block;text-decoration:none}
.l-by .who2{margin-left:clamp(0px,2vw,24px)}
@media(max-width:900px){.l-by .who2{margin-left:0}}
</style>
<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(FAQ_LD)}></script>
<section class="l-cover">
  <div class="stage">
