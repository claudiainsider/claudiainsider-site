<script is:inline>
(function(){var root=document.querySelector('.l-sched');if(!root)return;
var cards=root.querySelector('.cards'),prev=root.querySelector('.prev'),next=root.querySelector('.next'),time=root.querySelector('.time'),go=root.querySelector('.go');
var s1=root.querySelector('.s1'),s2=root.querySelector('.s2'),s3=root.querySelector('.s3'),how='In person',sel=null,off=0;
var D=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],M=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],ML=['January','February','March','April','May','June','July','August','September','October','November','December'];
var now=new Date(),tm=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1),st=new Date(2026,10,19);if(tm>st)st=tm;
var days=[];for(var i=0;i<18;i++){days.push(new Date(st.getFullYear(),st.getMonth(),st.getDate()+i));}
for(var h=9;h<=17;h++){var o=document.createElement('option');o.textContent=((h+11)%12+1)+':00 '+(h<12?'AM':'PM');time.appendChild(o);}
function draw(){cards.innerHTML='';days.slice(off,off+3).forEach(function(d){var b=document.createElement('button');b.type='button';b.className='day'+(sel&&+sel===+d?' on':'');b.innerHTML=D[d.getDay()]+'<b>'+d.getDate()+'</b>'+M[d.getMonth()];b.onclick=function(){sel=d;draw();chk();};cards.appendChild(b);});prev.disabled=off===0;next.disabled=off+3>=days.length;}
function chk(){go.disabled=!(sel&&time.value);}
prev.onclick=function(){off=Math.max(0,off-3);draw();};next.onclick=function(){off=Math.min(days.length-3,off+3);draw();};
time.onchange=chk;
[].forEach.call(root.querySelectorAll('.how button'),function(b){b.onclick=function(){[].forEach.call(root.querySelectorAll('.how button'),function(x){x.classList.remove('on')});b.classList.add('on');how=b.getAttribute('data-h');};});
go.onclick=function(){root.querySelector('.picked span').textContent=D[sel.getDay()]+', '+ML[sel.getMonth()]+' '+sel.getDate()+' at '+time.value+' · '+how;s1.hidden=true;s2.hidden=false;};
root.querySelector('.chg').onclick=function(e){e.preventDefault();s2.hidden=true;s1.hidden=false;};
var f=root.querySelector('#showing-form');
f.addEventListener('submit',function(e){
  e.preventDefault();
  f.elements.day.value=D[sel.getDay()]+', '+ML[sel.getMonth()]+' '+sel.getDate()+', '+sel.getFullYear();
  f.elements.time.value=time.value;f.elements.how.value=how;
  var b=f.querySelector('.send');b.disabled=true;b.textContent='Sending';
  var done=function(){s2.hidden=true;s3.hidden=false;s3.scrollIntoView({block:'nearest'});};
  if(!window.fetch){f.submit();return;}
  fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(f)).toString()})
    .then(function(r){if(!r.ok)throw 0;done();})
    .catch(function(){b.disabled=false;b.textContent='Request this showing';f.submit();});
});
draw();})();
</script>
