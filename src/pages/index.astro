---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <section class="hero">
      <h1>Claudia Insider</h1>
          <p class="tagline">Your guide to buying, selling, and living in San Francisco.</p>
              <p class="coming-soon">Site launching soon -- stay tuned.</p>
                </section>
                </BaseLayout>

                <style>
                  .hero {
                      text-align: center;
                          padding: 6rem 2rem;
                            }
                              h1 {
                                  font-size: 2.5rem;
                                      color: #1c1915;
                                          margin-bottom: 0.75rem;
                                            }
                                              .tagline {
                                                  font-size: 1.15rem;
                                                      color: #5b7f6a;
                                                          margin-bottom: 2rem;
                                                            }
                                                              .coming-soon {
                                                                  color: #887e72;
                                                                      font-style: italic;
                                                                        }
                                                                        </style>
