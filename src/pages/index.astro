<style is:inline>
/* ---- opener: full-bleed image, floating nav ---- */
.opener{position:relative;background:var(--espresso);overflow:hidden}
.opener .slide{display:none;position:relative}
.opener .slide.on{display:block}
.opener .slide img.bg{width:100%;height:100vh;height:100svh;object-fit:cover;object-position:var(--fp,50% 50%);display:block}
.opener .shade{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(80,46,34,.45) 0%,rgba(80,46,34,.08) 30%,rgba(80,46,34,.08) 55%,rgba(80,46,34,.55) 100%)}
.opener .slide:has(.ov.center) .shade{background:linear-gradient(to bottom,rgba(80,46,34,.45),rgba(80,46,34,.2) 40%,rgba(80,46,34,.2) 60%,rgba(80,46,34,.5)),radial-gradient(ellipse 45% 40% at 50% 50%,rgba(80,46,34,.5),transparent 70%)}
.opener .ov{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:0 var(--gut) clamp(32px,5vw,72px);max-width:var(--maxw);margin:0 auto;color:var(--linen)}
.opener .ov.center{justify-content:center;align-items:center;text-align:center;padding-bottom:0}
.opener .ov img.lg{height:auto}
.opener .ov .line{font-family:var(--serif);font-size:clamp(22px,3vw,40px);line-height:1.2;margin:0}
.opener .ov .line em{font-style:italic}
.opener .ov .btn{margin-top:22px;align-self:flex-start}
.opener .ov.center .btn{align-self:center}
.opener .arrows{position:absolute;inset:0;pointer-events:none}
.opener .arrows button{pointer-events:auto;position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:1px solid var(--linen);background:transparent;color:var(--linen);font-size:20px;cursor:pointer}
.opener .arrows .prev{left:var(--gut)}.opener .arrows .next{right:var(--gut)}
.opener .dots{position:absolute;right:var(--gut);bottom:clamp(32px,5vw,72px);display:flex;gap:8px}
.opener .dots i{width:7px;height:7px;border-radius:50%;border:1px solid var(--linen);display:block}
.opener .dots i.on{background:var(--linen)}
.opener .arrows button:hover{background:var(--linen);color:var(--espresso)}
/* floating nav over opener */
body.has-opener .nav{position:fixed;left:0;right:0;top:0;background:transparent;border-bottom-color:transparent;transition:background .25s,border-color .25s}
body.has-opener .nav .logo img.dk{display:none}
body.has-opener .nav .logo img.lt{display:block}
body.has-opener .nav ul a{color:var(--linen)}
body.has-opener .burger span{background:var(--linen)}
body.has-opener.scrolled .nav{background:var(--linen);border-bottom-color:var(--dune)}
body.has-opener.scrolled .nav .logo img.dk{display:block}
body.has-opener.scrolled .nav .logo img.lt{display:none}
body.has-opener.scrolled .nav ul a{color:var(--espresso)}
body.has-opener.scrolled .burger span{background:var(--espresso)}
.nav .logo img.lt{display:none}
@media(max-width:860px){
  .opener .slide img.bg{height:72vh;object-fit:cover;object-position:var(--fp,50% 50%)}
  .opener .ov{padding-bottom:28px}
  .opener .ov img.lg{max-width:70%}
  .opener .arrows button{width:38px;height:38px;font-size:16px}
}
</style>
<section class="opener" id="top">
  <div class="slide on">
    <div class="car">
      <img class="bg" src="/home/img/gg-view.jpg" alt="Rooftops of San Francisco with the Golden Gate Bridge" style="--fp:60% 50%">
      <img class="bg" src="/home/img/coit.jpg" alt="View of Coit Tower from a bay window" style="display:none;--fp:55% 50%">
      <img class="bg" src="/home/img/victorian.jpg" alt="Victorian facades in San Francisco" style="display:none;--fp:50% 40%">
      <img class="bg" src="/home/img/living.jpg" alt="Living room with bay windows" style="display:none;--fp:50% 50%">
    </div>
    <div class="shade"></div>
    <div class="ov"><img class="lg" src="/home/logo/secondary_logos_2-linen.svg" alt="claudia lee — real estate insider, San Francisco" style="width:min(380px,55%)"></div>
    <div class="arrows"><button class="prev" aria-label="Previous photo" onclick="carStep(-1)">&#8249;</button><button class="next" aria-label="Next photo" onclick="carStep(1)">&#8250;</button></div>
    <div class="dots" aria-hidden="true"></div>
  </div>
</section>
<script is:inline>
document.body.classList.add('has-opener');
let ci=0;const imgs=document.querySelectorAll('.opener .car img');const dots=document.querySelector('.opener .dots');imgs.forEach((_,i)=>{const d=document.createElement('i');if(i===0)d.className='on';dots.appendChild(d);});
function carStep(d){imgs[ci].style.display='none';ci=(ci+d+imgs.length)%imgs.length;imgs[ci].style.display='block';dots.querySelectorAll('i').forEach((x,i)=>x.classList.toggle('on',i===ci));}
let auto=setInterval(()=>carStep(1),6000);document.querySelector('.opener').addEventListener('pointerdown',()=>clearInterval(auto));
function onScroll(){document.body.classList.toggle('scrolled',window.scrollY>window.innerHeight*0.55);}
window.addEventListener('scroll',onScroll,{passive:true});onScroll();
</script>

<style is:inline>
/* ---- resources dropdown (desktop) + accordion (phone menu); matches /tics nav ---- */
.nav .has-sub{position:relative}
.nav ul.sub{display:none;position:absolute;top:100%;left:-18px;min-width:200px;padding:14px 18px;margin:8px 0 0;list-style:none;flex-direction:column;gap:12px;background:var(--linen);border:1px solid var(--dune)}
.nav ul.sub::before{content:"";position:absolute;left:0;right:0;top:-10px;height:10px}
.nav .has-sub:hover ul.sub,.nav .has-sub:focus-within ul.sub{display:flex}
body.has-opener .nav ul.sub a{color:var(--espresso)}
.menu nav .mres{border-bottom:1px solid var(--toffee)}
.menu nav .mres button{display:block;width:100%;background:none;border:0;cursor:pointer;font-family:var(--serif);font-size:24px;letter-spacing:.06em;text-transform:uppercase;color:var(--linen);padding:16px 0}
.menu nav .mres button span::after{content:"+";font-family:var(--sans);margin-left:10px}
.menu nav .mres.open button span::after{content:"\2013"}
.menu nav .mres .mlist{display:none;flex-direction:column;padding:0 0 14px}
.menu nav .mres.open .mlist{display:flex}
.menu nav .mres .mlist a{font-family:var(--sans);font-size:12px;letter-spacing:.2em;color:var(--dune);padding:8px 0;border:0}
/* ---- hero: Tatjana's type-led hero, laid out on the A v1 grid ---- */
.top{position:relative;overflow:hidden;background:var(--linen)}
.heroT{position:relative}
.mono{position:absolute;pointer-events:none;opacity:.55}
.top .mono{width:66%;left:-22%;top:-1%;transform:rotate(-12deg);opacity:.42;z-index:0}
.top>section{position:relative;z-index:1}
.heroT .g{position:relative;padding-block:clamp(28px,min(7vw,4.5vh),100px)}
.heroT .txt{display:grid;grid-template-columns:1.2fr .8fr;grid-template-rows:auto auto auto auto auto auto;column-gap:clamp(40px,7vw,110px);align-items:center}
.heroT .txt>*{grid-column:1}
.heroT .txt .pic{grid-column:2;grid-row:1/-1}
.heroT h1{font-size:clamp(30px,min(3.3vw,5.2vh),46px);line-height:1.18}
.heroT .name{font-family:var(--sans);text-transform:uppercase;letter-spacing:.32em;font-size:14px;margin:clamp(18px,3vh,34px) 0 0;color:var(--espresso)}
.heroT .rule{width:120px;height:1px;background:var(--espresso);margin:clamp(14px,2.4vh,24px) 0 clamp(18px,3vh,32px)}
.heroT .body{font-weight:300;font-size:16px;max-width:64ch}
.heroT .body b{font-weight:700}
.heroT .closer{font-weight:700;font-size:17px;margin-top:clamp(12px,2vh,20px)}
.heroT .acts{display:flex;gap:14px;flex-wrap:wrap;margin-top:clamp(18px,3vh,32px)}
.heroT .pic{position:relative;width:100%;max-width:min(440px,calc((100vh - 190px)*2/3));justify-self:end;align-self:center}
.heroT .pic .wm{position:absolute;right:20px;bottom:16px;width:110px;height:auto}

@media(max-width:860px){
  .heroT .g{padding-block:36px 56px}
  .heroT .txt{display:block}
  .top .mono{width:130%;left:-40%;top:0;transform:rotate(-8deg)}
  .heroT h1{font-size:clamp(24px,6.6vw,30px)}
  .heroT .pic{max-width:62%;margin:26px 0 6px auto}
  .heroT .pic .wm{width:84px;right:12px;bottom:10px}
  .heroT .name{margin-top:22px}
  .heroT .rule{margin:18px 0 22px}
  .heroT .body{font-size:16px}
  .heroT .acts{margin-top:24px}
  .heroT .acts .btn{width:100%;text-align:center}
}
/* ---- cards: Tatjana p.5/p.10 ---- */
.cardsT{position:relative;background:transparent}
.cardsT .wrap{position:relative;z-index:1}
.cardsT h2{font-size:clamp(30px,3.4vw,44px);padding-top:clamp(28px,min(5vw,5vh),72px)}
.cardsT .row{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:clamp(24px,4vh,40px)}
.cardT{background:#fff;display:flex;flex-direction:column;position:relative}
.cardT .b{padding:clamp(18px,2.6vh,26px) 28px clamp(22px,3vh,32px);display:flex;flex-direction:column;flex:1}
.cardT h3{font-size:26px}
.cardT .r{width:56px;height:2px;background:var(--terracotta);margin:14px 0 18px}
.cardT p{font-size:15px;font-weight:300;flex:1}
.cardT .btn{align-self:flex-start;margin-top:22px;background:var(--taupe);border-color:var(--taupe)}
.cardT .btn:hover{background:var(--espresso);border-color:var(--espresso)}
.cardsT::after{content:"";position:absolute;left:0;right:0;bottom:0;height:120px;background:var(--terracotta)}
.cardsT .pad{height:60px}
@media(max-width:900px){
  .cardsT .row{grid-template-columns:1fr;gap:14px;margin-top:24px}
  .cardT{display:grid;grid-template-columns:112px 1fr;align-items:center}
  .cardT img.ph-land{aspect-ratio:3/2;height:100%;object-fit:cover}
  .cardT .b{padding:16px 16px 16px 18px}
  .cardT h3{font-size:19px}
  .cardT .r{width:36px;margin:8px 0 8px}
  .cardT p{display:none}
  .cardT .btn{margin-top:0;padding:10px 14px;font-size:10px}
  .cardsT::after{height:70px}
  .cardsT .pad{height:36px}
}
/* ---- neighborhoods ---- */
.hoodT{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--dune);border:1px solid var(--dune);margin-top:36px}
.hoodT a{background:var(--linen);padding:22px 18px;text-decoration:none;font-family:var(--serif);font-size:19px}
.hoodT a small{display:block;font-family:var(--sans);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--taupe);margin-top:6px}
.hoodT a:hover{background:var(--dune)}
@media(max-width:900px){.hoodT{grid-template-columns:1fr 1fr}}
/* ---- neighborhoods map ---- */
.mapwrap{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(28px,5vw,64px);align-items:start;margin-top:36px}
.sfmap{width:100%;height:auto;display:block}
.sfmap .city{fill:var(--linen);stroke:var(--toffee);stroke-width:1.2;stroke-linejoin:round;opacity:.7}
.sfmap .park{fill:var(--dune);stroke:var(--toffee);stroke-width:.8;opacity:.9}
.sfmap .lm{font-family:var(--sans);font-size:9px;letter-spacing:.16em;fill:var(--taupe)}
.sfmap .hood{cursor:pointer;outline:none}
.sfmap .hood polygon{fill:#fff;stroke:var(--espresso);stroke-width:1.1;stroke-linejoin:round;transition:fill .15s}
.hoodsT .lede{color:var(--espresso)}
.hoodsT{padding-bottom:clamp(40px,5vw,72px)}
.sfmap .hood text{font-family:var(--serif);font-size:11px;fill:var(--espresso);pointer-events:none}
.sfmap .hood:hover polygon,.sfmap .hood:focus polygon{fill:var(--linen)}
.sfmap .hood.on polygon{fill:var(--terracotta)}
.sfmap .hood.on text{fill:var(--linen)}
.mapcard{background:#fff;padding:28px 30px 30px;position:sticky;top:96px}
.mapcard h3{font-size:26px;margin-bottom:12px}
.mapcard .tlink{display:inline-block;margin-top:6px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px;padding-top:20px;border-top:1px solid var(--dune)}
.chips button{font-family:var(--sans);font-size:11px;letter-spacing:.14em;text-transform:uppercase;background:transparent;border:1px solid var(--dune);color:var(--espresso);padding:8px 12px;cursor:pointer}
.hoodsT .chips{border-top-color:var(--linen)}
.chips button:hover{border-color:var(--espresso)}
.chips button.on{background:var(--terracotta);border-color:var(--terracotta);color:var(--linen)}
@media(max-width:900px){.mapwrap{grid-template-columns:1fr;gap:14px;margin-top:20px}.mapcard{position:static;padding:18px 20px;display:none}.mapcard.show{display:block}.mapcard h3{font-size:22px}.mapcard .chips{display:none}.sfmap .hood text{font-size:13px}.sfmap .lm{font-size:10px}.hoodsT .lede{font-size:16px}}
/* ---- about: Tatjana p.15 ---- */
.aboutT{position:relative;overflow:hidden}
.aboutT .mono{width:64%;left:-22%;top:-38%;transform:rotate(-14deg)}
.aboutT .g{position:relative;display:grid;grid-template-columns:min(320px,calc((100vh - 220px)*2/3)) 1fr;gap:clamp(32px,6vw,90px);align-items:center;padding-block:clamp(56px,min(8vw,10vh),120px)}
.aboutT .pic{position:relative;width:min(320px,calc((100vh - 220px)*2/3))}
.aboutT .pic .stamp{position:absolute;right:-80px;top:-80px;width:180px}
.aboutT .g > div:last-child{padding-top:clamp(40px,8vh,120px)}
.aboutT h2{font-size:clamp(30px,3.4vw,46px)}
@media(max-width:900px){.aboutT .g{grid-template-columns:1fr;gap:28px;padding-block:72px 64px}.aboutT .g > div:last-child{padding-top:0}.aboutT .pic{width:min(300px,72%);margin-top:40px}.aboutT .pic .stamp{right:-56px;top:-64px;width:132px}}
/* ---- newsletter: Tatjana p.17 ---- */
.bottom{position:relative;overflow:hidden;background:var(--espresso)}
.bottom>.mono{z-index:0}
.bottom>section,.bottom>footer{position:relative;z-index:1}
.bottom .foot{background:transparent}
.bottom .foot .wrap{border-top:1px solid var(--toffee);padding-top:clamp(40px,5vw,64px)}
.newsT{position:relative;background:transparent;color:var(--linen)}
.bottom>.mono{width:46%;right:-5%;top:4%;transform:none;opacity:.4}
.newsT .g{position:relative;display:grid;grid-template-columns:160px 1fr;gap:clamp(28px,5vw,72px);align-items:start;padding-block:clamp(64px,8vw,110px)}
.newsT h2{color:var(--linen)}
.newsT .box{display:inline-block;background:var(--terracotta);color:var(--linen);padding:4px 14px}
@media(max-width:700px){.newsT .g{grid-template-columns:1fr}.newsT .stamp{width:120px}}
</style>

<div class="top">
<img class="mono" src="/home/logo/swoosh_dune.svg" alt="">
<section class="heroT">
  <div class="wrap g">
    <div class="txt">
      <h1>A home is the biggest purchase most of us will ever make. It's also where your life <em>happens.</em></h1>
      <div class="pic">
        <img class="ph-portrait" src="/home/img/DSC05516-tight.jpg" alt="Claudia Lee">
        <img class="wm" src="/home/logo/wordmark_claudia_white.png" alt="">
      </div>
      <p class="name">Claudia Lee</p>
      <div class="rule"></div>
      <p class="body">Buying in San Francisco is competitive and overwhelming, and the stakes are real. It's <b>the morning light you'll wake up to</b>, the walk you'll take a thousand times, <b>the front door that starts to feel like yours</b>, and the number that has to make sense on paper before it can make sense anywhere else. Selling means handing <b>a place full of your memories</b> to whoever comes next, and trusting someone to find the right next stewards for it. I don't take either lightly. You get my full attention, <b>honest numbers, and a steady hand</b> through every step. <b>It's an honor</b> to be the one walking beside you, and I treat it like one.</p>
      <p class="closer">Find the place that feels right.</p>
      <div class="acts"><a class="btn" href="https://calendar.app.google/Unk61s7yj1tfr7eD7">Book a 20-min discovery call</a></div>
    </div>
  </div>
</section>

<section class="cardsT" id="buyers"><div class="wrap">
  <h2>Where do I <em>even</em> start?</h2>
  <div class="row">
    <div class="cardT"><img class="ph-land" src="/home/img/baywindow.jpg" alt=""><div class="b"><h3>Buying in SF</h3><div class="r"></div><p>Pre-approval, broker tours, and what "over asking" actually means here. The free guide covers the whole timeline.</p><a class="btn" href="/buyer-guide/">Buyer's guide</a></div></div>
    <div class="cardT" id="sellers"><img class="ph-land" src="/home/img/living.jpg" alt=""><div class="b"><h3>Selling in SF</h3><div class="r"></div><p>Prep that moves the needle vs. money you'll never see again, and how pricing really works in this market.</p><a class="btn" href="/seller-guide/">Seller's guide</a></div></div>
    <div class="cardT" id="calc" style="scroll-margin-top:90px"><img class="ph-land" src="/home/img/kitchen.jpg" alt=""><div class="b"><h3>Can I even afford this?</h3><div class="r"></div><p>Plug in your real numbers. Rent vs. own, side by side, down to what's left to live on. That's the number that matters.</p><a class="btn" href="/calculator/">Open the calculator</a></div></div>
  </div>
  <div class="pad"></div>
</div></section>
</div>

<section class="aboutT band-dune" id="about">
  <div class="wrap g">
    <div class="pic"><img class="ph-portrait" src="/home/img/DSC05935.jpg" alt="Claudia Lee"><img class="stamp" src="/home/logo/stamp_name_black.png" alt="claudia lee — real estate insider, San Francisco"></div>
    <div>
      <h2>Helping you navigate <em>San Francisco</em> with knowledge, confidence, and a personal approach.</h2>
      <p class="lede" style="margin-top:22px">I grew up helping my grandma manage her East Bay rentals, hit an 815 credit score before 24, and competed on the US national karate team three times (calm under pressure is a real skill in a multiple-offer situation). I'd rather you understand your numbers than sign anything fast.</p>
      <a class="btn" href="/about/" style="margin-top:28px">Read more</a>
    </div>
  </div>
</section>

<div class="bottom">
<img class="mono" src="/home/logo/swoosh_toffee.svg" alt="">
<section class="newsT" id="newsletter">
  <div class="wrap g">
    <img class="stamp" src="/home/logo/stamp_mark_linen.png" alt="" style="width:160px">
    <div style="max-width:640px">
      <p class="sub" style="color:var(--dune)">The San Francisco Insider</p>
