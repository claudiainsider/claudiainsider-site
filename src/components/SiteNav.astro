---
// Shared nav + phone menu for inner pages (home has its own transparent-over-photo variant).
// current: 'buyers' | 'sellers' | 'resources' | 'about' | 'newsletter'
const { current = '' } = Astro.props;
const BOOK_20 = 'https://calendar.app.google/Unk61s7yj1tfr7eD7';
const cur = (k) => (current === k ? 'page' : undefined);
---
<header class="nav"><div class="in">
  <a class="logo" href="/"><img src="/home/logo/primary_logos_1-black.svg" alt="claudia lee — SF real estate insider"></a>
  <ul><li><a href="/buyers/" aria-current={cur('buyers')}>Buyers</a></li><li><a href="/sellers/" aria-current={cur('sellers')}>Sellers</a></li><li class="has-sub"><a href="/resources/" aria-current={cur('resources')}>Resources</a><ul class="sub"><li><a href="/resources/">All resources</a></li><li><a href="/tics/">Condos vs. TICs</a></li><li><a href="/calculator/">Calculator</a></li></ul></li><li><a href="/about/" aria-current={cur('about')}>About</a></li><li><a href="/newsletter/" aria-current={cur('newsletter')}>Newsletter</a></li></ul>
  <a class="cta" href={BOOK_20}>Discovery call</a>
  <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" onclick="document.body.classList.add('menu-open');this.setAttribute('aria-expanded','true')"><span></span><span></span><span></span></button>
</div></header>
<div class="menu" aria-hidden="true">
  <button class="close" type="button" aria-label="Close menu" onclick="document.body.classList.remove('menu-open')">&times;</button>
  <img class="menu-logo" src="/home/logo/primary_logos_1-linen.svg" alt="claudia lee — SF real estate insider">
  <nav><a href="/buyers/">Buyers</a><a href="/sellers/">Sellers</a><div class="mres"><button type="button" aria-expanded="false" onclick="var o=this.parentNode.classList.toggle('open');this.setAttribute('aria-expanded',o)">Resources<span aria-hidden="true"></span></button><div class="mlist"><a href="/resources/">All resources</a><a href="/tics/">Condos vs. TICs</a><a href="/calculator/">Calculator</a></div></div><a href="/about/">About</a><a href="/newsletter/">Newsletter</a></nav>
  <a class="btn linen" href={BOOK_20}>Book a 20-min discovery call</a>
</div>
